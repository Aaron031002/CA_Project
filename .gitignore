.vscode/
.DS_Store
*~

# ─── Third-party dependencies ───────────────────────────────────────
# yaml-cpp used to be gitignored here (students expected to `git clone`
# it themselves into third_party/yaml-cpp, per new_code/CMakeLists.txt's
# add_subdirectory). This repo is distributed as a ZIP download (private
# repo, no git access for students) rather than `git clone`, so that
# option doesn't work -- vendored in full instead (see third_party/
# yaml-cpp/, ~3.3MB/394 files, MIT-licensed) so a fresh unzip builds with
# no extra fetch step. third_party/yaml-cpp/.gitignore (its own build/
# artifacts) still applies underneath this.

# ─── Scratch / ephemeral debug output ──────────────────────────────
session_state_dir/scratch/

# ─── Local files that are not part of this project ─────────────────
session_state_dir/
plan_dir/
spec_dir/
/CLAUDE.md
/CMakeLists.txt

tools/

